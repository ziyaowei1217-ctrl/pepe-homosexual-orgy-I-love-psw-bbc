# Local web configuration; these values work with pnpm dev:local.
# Production build variables are listed in .env.production.example.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
# Leave empty to use the built-in local map fallback.
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=""
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Public build-time configuration. Replace these examples before production use.
NEXT_PUBLIC_API_BASE_URL="https://api.example.com/api/v1"
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE="https://maps.example.com/tiles/{z}/{x}/{y}.png?key=replace-me"
NEXT_PUBLIC_MAP_ATTRIBUTION="© Map provider"
# Server-only runtime secret for the web container, never a build arg or NEXT_PUBLIC_ value.
# Optional: a Claude API key turns on the AI assistant; empty hides it.
ANTHROPIC_API_KEY=""
# Optional host ports; the API and web containers always listen on 4000 and 3000.
API_HOST_PORT="4000"
WEB_HOST_PORT="3000"

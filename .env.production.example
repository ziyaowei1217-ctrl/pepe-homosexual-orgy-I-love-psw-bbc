# Public build-time configuration. Replace these examples before production use.
NEXT_PUBLIC_API_BASE_URL="https://api.example.com/api/v1"
NEXT_PUBLIC_MEDIA_UPLOAD_ORIGIN="https://uploads.example.com"
# Real shared Google accounts for the connected beta. Keep all three NEON_AUTH_*
# values server-side; only the provider choice is public. Email remains the default
# when NEXT_PUBLIC_AUTH_PROVIDER is unset. API needs AUTH_PROVIDER=neon separately.
NEXT_PUBLIC_AUTH_PROVIDER="neon"
# Sign-in methods shown with Neon: google, github, email, phone (comma list).
# Unset means Google only. github needs an OAuth app in the Neon console;
# phone needs PHONE_AUTH_PROVIDER=twilio-verify on the API.
NEXT_PUBLIC_AUTH_METHODS="google,email"
NEON_AUTH_BASE_URL=""
NEON_AUTH_APP_ORIGIN="https://sublet-pipeline-demo-zihao.netlify.app"
NEON_AUTH_COOKIE_SECRET=""
# MapLibre uses OpenFreeMap by default. A different vector style is optional.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
# Optional alternative raster basemap; include {z}, {x}, {y} and its attribution.
NEXT_PUBLIC_MAP_TILE_URL_TEMPLATE=""
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
# On Netlify the server can use the public API URL above. If set, this must also
# be reachable over HTTPS from Netlify, rather than a local Compose hostname.
API_INTERNAL_BASE_URL=""
# Server-only runtime secret for the web container, never a build arg or NEXT_PUBLIC_ value.
# Optional: a Claude API key turns on the AI assistant; empty hides it.
ANTHROPIC_API_KEY=""
# Set this at Netlify Functions scope too. An explicit provider base URL stops
# Netlify auto-injecting its metered gateway key when no own key is configured.
ANTHROPIC_BASE_URL="https://api.anthropic.com"
# Optional host ports; the API and web containers always listen on 4000 and 3000.
API_HOST_PORT="4000"
WEB_HOST_PORT="3000"

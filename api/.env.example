DATABASE_URL="postgresql://sublet:sublet@localhost:5432/sublet_pipeline?schema=public"

# Local development can use this fallback. Production must set a strong, non-default secret.
NODE_ENV="development"
JWT_SECRET="dev-change-me"
EMAIL_SENDER="console"
EMAIL_FROM="Sublet Pipeline <no-reply@example.com>"
# Production: EMAIL_SENDER=resend and all secrets/endpoints below are required.
# Hash secrets must each be at least 32 UTF-8 bytes, non-default, and distinct from one another.
RESEND_API_KEY=""
OTP_HASH_SECRET=""
SECURITY_IDENTIFIER_HASH_SECRET=""
# Optional. Empty uses supported single-instance Socket.IO and local message rate limiting.
# Configured enables distributed Socket.IO fan-out and distributed message rate limiting.
# Never place Valkey credentials in logs or health output.
VALKEY_URL=""
AUTH_CODE_TTL_SECONDS="600"
AUTH_CODE_MAX_ATTEMPTS="5"
AUTH_CODE_COOLDOWN_SECONDS="60"
TRUSTED_PROXY_HOPS="0"
# Development only: comma-separated emails that receive ADMIN after local email-code verification.
# Production startup fails when this value is non-empty; use the audited admin:roles commands instead.
LOCAL_ADMIN_EMAILS=""

PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Private S3-compatible object storage. Production must set every value explicitly.
# The upload endpoint must be reachable from renters' and hosts' browsers.
LISTING_MEDIA_STORAGE_ENDPOINT="http://localhost:9000"
LISTING_MEDIA_UPLOAD_ENDPOINT="http://localhost:9000"
LISTING_MEDIA_STORAGE_REGION="us-east-1"
LISTING_MEDIA_STORAGE_BUCKET="listing-media"
LISTING_MEDIA_STORAGE_ACCESS_KEY_ID="minio"
LISTING_MEDIA_STORAGE_SECRET_ACCESS_KEY="minio-development"
LISTING_MEDIA_UPLOAD_TTL_SECONDS="600"

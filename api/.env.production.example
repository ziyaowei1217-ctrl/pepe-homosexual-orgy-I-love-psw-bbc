NODE_ENV="production"
PORT="4000"

DATABASE_URL=""
WEB_ORIGIN=""
JWT_SECRET=""
OTP_HASH_SECRET=""
SECURITY_IDENTIFIER_HASH_SECRET=""

EMAIL_SENDER="resend"
EMAIL_FROM=""
RESEND_API_KEY=""

# Payment gateway adapter contract (see docs/external-integrations.md).
PAYMENT_SERVICE_URL=""
PAYMENT_SERVICE_API_KEY=""

# SMS sign-in for already-linked numbers. "disabled" hides it. Twilio Verify
# needs the account SID, a Verify service SID (VA...) and an API key pair
# (or the auth token instead of the key pair). Regions: US_CA and/or CN.
PHONE_AUTH_PROVIDER="disabled"
PHONE_AUTH_REGIONS="US_CA"
TWILIO_ACCOUNT_SID=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""

AUTH_CODE_TTL_SECONDS="600"
AUTH_CODE_MAX_ATTEMPTS="5"
AUTH_CODE_COOLDOWN_SECONDS="60"
TRUSTED_PROXY_HOPS="0"
LOCAL_ADMIN_EMAILS=""

# Required in production for durable multi-instance realtime messaging and shared rate limiting.
VALKEY_URL=""

LISTING_MEDIA_STORAGE_ENDPOINT=""
LISTING_MEDIA_UPLOAD_ENDPOINT=""
LISTING_MEDIA_STORAGE_REGION=""
LISTING_MEDIA_STORAGE_BUCKET=""
LISTING_MEDIA_STORAGE_ACCESS_KEY_ID=""
LISTING_MEDIA_STORAGE_SECRET_ACCESS_KEY=""
LISTING_MEDIA_UPLOAD_TTL_SECONDS="600"

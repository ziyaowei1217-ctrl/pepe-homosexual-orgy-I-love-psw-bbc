generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  LEASED
}

enum VerificationPurpose {
  LOGIN
  ADMIN_STEP_UP
}

enum VerificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum MediaStorageStatus {
  PENDING_UPLOAD
  UPLOADED_PENDING_VALIDATION
  READY
  PUBLISHED
  FAILED
}

enum MediaReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoommateActionType {
  LIKE
  PASS
  LATER
}

enum DealRoomStatus {
  ACTIVE
  ARCHIVED
}

enum TourRequestStatus {
  REQUESTED
  SCHEDULED
  CANCELLED
}

enum ViewingMode {
  IN_PERSON
  VIDEO
}

enum ViewingRequestStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  legacyLeaseApplications         LeaseApplication[] @relation("LegacyLeaseApplicant") @ignore
  legacyOwnedLeaseApplications    LeaseApplication[] @relation("LegacyLeaseOwner") @ignore
  id                              String                       @id @default(cuid())
  email                           String                       @unique
  role                            UserRole                     @default(USER)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  listings                        Listing[]
  roommateActions                 RoommateAction[]
  ownedDealRooms                  DealRoom[]
  tourRequests                    TourRequest[]
  renterDealThreads               DealThread[]                 @relation("RenterDealThreads")
  ownedListingThreads             DealThread[]                 @relation("ListingOwnerDealThreads")
  dealMessages                    DealMessage[]
  viewingRequests                 ViewingRequest[]
  roommateProfile                 RoommateProfile?             @relation("RoommateProfileOwner")
  firstRoommateMatches            RoommateMatch[]              @relation("RoommateMatchFirstUser")
  secondRoommateMatches           RoommateMatch[]              @relation("RoommateMatchSecondUser")
  roommateConversationMemberships RoommateConversationMember[]
  sentRoommateMessages            RoommateMessage[]
  roommateTeamMemberships         RoommateTeamMember[]
  sentRoommateTeamInvites         RoommateTeamInvite[]         @relation("RoommateTeamInviteInviter")
  receivedRoommateTeamInvites     RoommateTeamInvite[]         @relation("RoommateTeamInviteInvitee")
  dissolvedRoommateTeams          RoommateTeam[]               @relation("RoommateTeamDissolver")
  submittedRentalApplications     RentalApplication[]          @relation("RentalApplicationSubmitter")
  ownedRentalApplications         RentalApplication[]          @relation("RentalApplicationListingOwner")
  decidedRentalApplications       RentalApplication[]          @relation("RentalApplicationDecisionBy")
  cancelledRentalApplications     RentalApplication[]          @relation("RentalApplicationCancelledBy")
  demoPaymentsAsPayer             DemoPayment[]                @relation("DemoPaymentPayer")
  demoPaymentsAsPayee             DemoPayment[]                @relation("DemoPaymentPayee")
  demoPaymentAttempts             DemoPaymentAttempt[]         @relation("DemoPaymentAttemptActor")
}

model Profile {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String                    @unique
  displayName      String?                   @map("display_name")
  avatarUrl        String?                   @map("avatar_url")
  school           String?
  city             String?
  role             String                    @default("renter")
  eduEmailVerified Boolean                   @default(false) @map("edu_email_verified")
  phoneVerified    Boolean                   @default(false) @map("phone_verified")
  wechat           String?
  instagram        String?
  bio              String?
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roommateProfiles RoommateMatchingProfile[]
  housingListings  HousingListing[]

  @@index([school, city])
  @@map("profiles")
}

model VerificationCode {
  id                String                     @id @default(cuid())
  email             String
  purpose           VerificationPurpose        @default(LOGIN)
  codeHash          String
  codeSalt          String?
  hashVersion       Int                        @default(1)
  attemptCount      Int                        @default(0)
  deliveryStatus    VerificationDeliveryStatus @default(PENDING)
  sentAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                   @default(now())

  @@index([email, consumedAt, expiresAt])
  @@index([email, purpose, deliveryStatus, createdAt])
  @@index([deliveryStatus, createdAt])
}

model BetaInvite {
  id               String    @id @default(cuid())
  normalizedEmail  String    @unique
  createdBy        String
  reason           String?
  invitedAt        DateTime  @default(now())
  claimedAt        DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  @@index([normalizedEmail, revokedAt])
  @@index([invitedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorType   String
  actorUserId String?
  actorEmail  String?
  action      String
  targetType  String
  targetId    String?
  outcome     String
  requestId   String?
  ipHash      String?
  deviceHash  String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([requestId])
}

model Listing {
  initializationReceipts ListingMediaInitialization[]
  id                 String              @id @default(cuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id])
  title              String
  area               String
  image              String?
  availableFrom      DateTime            @db.Date
  availableTo        DateTime            @db.Date
  price              Int
  originalPrice      Int
  beds               Int
  baths              Int
  commute            String
  transit            String
  trust              String
  tags               String[]
  score              Float               @default(4.8)
  status             ListingStatus       @default(DRAFT)
  revision           Int                 @default(0)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewerId         String?
  rejectionReason    String?
  suspendedAt        DateTime?
  suspendedBy        String?
  suspensionReason   String?
  media              ListingMedia[]
  dealThreads        DealThread[]
  rentalApplications RentalApplication[]
  legacyLeaseApplications LeaseApplication[] @ignore
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([status, availableFrom, availableTo])
  @@index([ownerId, status, updatedAt])
}

model HousingListing {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  owner             Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  listingType       String    @map("listing_type")
  propertyType      String    @map("property_type")
  roomType          String    @map("room_type")
  priceMonthly      Int       @map("price_monthly")
  depositAmount     Int?      @map("deposit_amount")
  city              String
  neighborhood      String?
  schoolNearby      String?   @map("school_nearby")
  addressApprox     String?   @map("address_approx")
  lat               Decimal?  @db.Decimal(9, 6)
  lng               Decimal?  @db.Decimal(9, 6)
  moveInDate        DateTime  @map("move_in_date") @db.Date
  moveOutDate       DateTime? @map("move_out_date") @db.Date
  flexibleDates     Boolean   @default(false) @map("flexible_dates")
  bedrooms          Decimal   @db.Decimal(4, 1)
  bathrooms         Decimal   @db.Decimal(4, 1)
  furnished         Boolean   @default(false)
  utilitiesIncluded Boolean   @default(false) @map("utilities_included")
  laundry           Boolean   @default(false)
  parking           Boolean   @default(false)
  petsAllowed       Boolean   @default(false) @map("pets_allowed")
  leaseApproved     Boolean   @default(false) @map("lease_approved")
  description       String?
  photoUrls         String[]  @default([]) @map("photo_urls")
  status            String    @default("draft")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId, status, updatedAt])
  @@index([city, neighborhood, priceMonthly])
  @@index([listingType, roomType, status])
  @@map("listings")
}

model ListingMediaInitialization {
  ownerId     String
  commandId   String
  fingerprint String
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mediaId     String? @unique
  media       ListingMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@id([ownerId, commandId])
  @@index([listingId])
}

model ListingMedia {
  id                 String             @id @default(cuid())
  initializationReceipt ListingMediaInitialization?
  listingId          String
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url                String?
  kind               String
  sortOrder          Int                @default(0)
  originalKey        String?
  processedKey       String?
  publicMainKey      String?
  publicThumbnailKey String?
  mimeType           String?
  sizeBytes          Int?
  width              Int?
  height             Int?
  checksum           String?
  uploadExpiresAt    DateTime?
  storageStatus      MediaStorageStatus @default(PENDING_UPLOAD)
  reviewStatus       MediaReviewStatus  @default(PENDING)
  securityErrorCode  String?
  finalizedAt        DateTime?
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  @@index([listingId, storageStatus, sortOrder])
  @@index([listingId, reviewStatus, sortOrder])
  @@index([uploadExpiresAt])
}

model RoommateProfile {
  id                  String           @id @default(cuid())
  ownerId             String?          @unique
  owner               User?            @relation("RoommateProfileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name                String
  age                 Int
  role                String
  image               String
  match               Int
  budget              String
  commute             String
  tags                String[]
  status              String           @default("active")
  archivedAt          DateTime?
  localReciprocalLike Boolean          @default(false)
  createdAt           DateTime         @default(now())
  actions             RoommateAction[]
  dealRooms           DealRoom[]
  dealRoomMembers     DealRoomMember[]

  @@index([status, match])
}

enum RoommateMatchStatus {
  ACTIVE
  CLOSED
}

enum RoommateTeamStatus {
  ACTIVE
  DISSOLVED
}

enum RoommateTeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum RentalApplicationScope {
  SOLO
  TEAM
}

enum RentalApplicationStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
  COMPLETED
  CANCELLATION_PENDING
}

enum RentalIncomeBand {
  BELOW_2X
  TWO_TO_THREE_X
  THREE_TO_FOUR_X
  ABOVE_FOUR_X
  PREFER_NOT_TO_SAY
}

enum GuarantorStatus {
  AVAILABLE
  NOT_AVAILABLE
  NOT_NEEDED
}

enum DemoPaymentStatus {
  AWAITING_ATTEMPT
  HELD
  REFUNDED
  RELEASED
  CLOSED
}

enum DemoPaymentAttemptOutcome {
  SUCCEEDED
  FAILED
}

enum DemoHeldFundStatus {
  HELD
  REFUNDED
  RELEASED
}

enum DemoLedgerEvent {
  HOLD
  REFUND
  RELEASE
}

enum DemoLedgerAccount {
  RENTER_CLEARING
  HELD_FUNDS
  HOST_CLEARING
}

enum DemoLedgerDirection {
  DEBIT
  CREDIT
}

model RoommateMatch {
  id           String                @id @default(cuid())
  firstUserId  String
  secondUserId String
  status       RoommateMatchStatus   @default(ACTIVE)
  matchedAt    DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  firstUser    User                  @relation("RoommateMatchFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser   User                  @relation("RoommateMatchSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  conversation RoommateConversation?
  teamInvites  RoommateTeamInvite[]

  @@unique([firstUserId, secondUserId])
  @@index([firstUserId, status, updatedAt])
  @@index([secondUserId, status, updatedAt])
}

model RoommateTeam {
  id                 String               @id @default(cuid())
  status             RoommateTeamStatus   @default(ACTIVE)
  dealRoomId         String?              @unique
  confirmedAt        DateTime             @default(now())
  dissolvedAt        DateTime?
  dissolvedById      String?
  dissolveReason     String?
  dealRoom           DealRoom?            @relation(fields: [dealRoomId], references: [id], onDelete: SetNull)
  dissolvedBy        User?                @relation("RoommateTeamDissolver", fields: [dissolvedById], references: [id], onDelete: SetNull)
  members            RoommateTeamMember[]
  invites            RoommateTeamInvite[]
  rentalApplications RentalApplication[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, updatedAt])
}

// Retained for migration compatibility. Current application code uses RentalApplication.
enum LeaseApplicationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model LeaseApplication {
  id                 String                 @id
  listingId          String
  threadId           String                 @unique
  applicantId        String
  listingOwnerId     String
  moveInDate         DateTime               @db.Date
  moveOutDate        DateTime               @db.Date
  occupantCount      Int
  introduction      String
  profileSnapshot   Json
  status             LeaseApplicationStatus @default(SUBMITTED)
  decisionReason    String?
  version            Int                    @default(1)
  submittedAt       DateTime               @default(now())
  decidedAt         DateTime?
  withdrawnAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime
  applicant         User                   @relation("LegacyLeaseApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  owner             User                   @relation("LegacyLeaseOwner", fields: [listingOwnerId], references: [id], onDelete: Cascade)
  listing           Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  thread            DealThread             @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([applicantId, listingId])
  @@index([applicantId, status, submittedAt])
  @@index([listingId, status, submittedAt])
  @@index([listingOwnerId, status, submittedAt])
  @@ignore
}

model RentalApplication {
  id                 String                  @id @default(cuid())
  listingId          String
  listingOwnerId     String
  submitterId        String
  teamId             String?
  scope              RentalApplicationScope
  status             RentalApplicationStatus @default(DRAFT)
  activeKey          String?                 @unique
  acceptedListingKey String?                 @unique
  memberSnapshots    Json
  contactName        String?
  contactEmail       String?
  moveIn             DateTime                @db.Date
  moveOut            DateTime                @db.Date
  schoolOrOccupation String
  incomeBand         RentalIncomeBand
  guarantorStatus    GuarantorStatus
  note               String
  createKey          String                  @unique
  submitKey          String?                 @unique
  withdrawKey        String?                 @unique
  decisionKey        String?                 @unique
  cancelKey          String?                 @unique
  submittedAt        DateTime?
  decidedAt          DateTime?
  decisionById       String?
  decisionReason     String?
  withdrawnAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  demoPayment        DemoPayment?
  paymentOperations  PaymentOperation[]
  listing            Listing                 @relation(fields: [listingId], references: [id], onDelete: Restrict)
  listingOwner       User                    @relation("RentalApplicationListingOwner", fields: [listingOwnerId], references: [id], onDelete: Restrict)
  submitter          User                    @relation("RentalApplicationSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  team               RoommateTeam?           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  decisionBy         User?                   @relation("RentalApplicationDecisionBy", fields: [decisionById], references: [id], onDelete: SetNull)
  cancelledBy        User?                   @relation("RentalApplicationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([submitterId, status, updatedAt])
  @@index([teamId, status, updatedAt])
  @@index([listingOwnerId, status, updatedAt])
  @@index([listingId, status, updatedAt])
}

enum PaymentOperationKind {
  ACCEPT
  CANCEL
}

enum PaymentOperationStatus {
  PENDING
  SUCCEEDED
  BLOCKED
}

model PaymentOperation {
  id             String                 @id
  applicationId  String
  kind           PaymentOperationKind
  status         PaymentOperationStatus @default(PENDING)
  actorId        String?
  providerKey    String                 @unique
  result         String?
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  lockedUntil    DateTime?
  lockToken      String?
  lastError      String?
  application    RentalApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([applicationId, kind])
  @@index([status, nextAttemptAt])
}

model DemoPayment {
  id            String               @id @default(cuid())
  applicationId String               @unique
  payerId       String
  payeeId       String
  amountCents   Int
  currency      String               @default("USD")
  status        DemoPaymentStatus    @default(AWAITING_ATTEMPT)
  application   RentalApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  payer         User                 @relation("DemoPaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee         User                 @relation("DemoPaymentPayee", fields: [payeeId], references: [id], onDelete: Restrict)
  attempts      DemoPaymentAttempt[]
  heldFund      DemoHeldFund?
  ledgerEntries DemoLedgerEntry[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([payerId, status, updatedAt])
  @@index([payeeId, status, updatedAt])
}

model DemoPaymentAttempt {
  id             String                    @id @default(cuid())
  paymentId      String
  actorId        String
  idempotencyKey String                    @unique
  outcome        DemoPaymentAttemptOutcome
  applied        Boolean                   @default(false)
  payment        DemoPayment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor          User                      @relation("DemoPaymentAttemptActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime                  @default(now())

  @@index([paymentId, createdAt])
  @@index([actorId, createdAt])
}

model DemoHeldFund {
  id                    String             @id @default(cuid())
  paymentId             String             @unique
  amountCents           Int
  status                DemoHeldFundStatus @default(HELD)
  renterConfirmedAt     DateTime?
  ownerConfirmedAt      DateTime?
  renterConfirmationKey String?            @unique
  ownerConfirmationKey  String?            @unique
  refundKey             String?            @unique
  releaseKey            String?            @unique
  refundedAt            DateTime?
  releasedAt            DateTime?
  payment               DemoPayment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerEntries         DemoLedgerEntry[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, updatedAt])
}

model DemoLedgerEntry {
  id             String              @id @default(cuid())
  transactionId  String
  paymentId      String
  heldFundId     String
  event          DemoLedgerEvent
  account        DemoLedgerAccount
  direction      DemoLedgerDirection
  amountCents    Int
  idempotencyKey String
  payment        DemoPayment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  heldFund       DemoHeldFund        @relation(fields: [heldFundId], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())

  @@unique([transactionId, account, direction])
  @@unique([idempotencyKey, account, direction])
  @@index([paymentId, createdAt])
  @@index([heldFundId, createdAt])
  @@index([idempotencyKey])
}

model RoommateTeamMember {
  id       String       @id @default(cuid())
  teamId   String
  userId   String
  snapshot Json
  active   Boolean      @default(true)
  joinedAt DateTime     @default(now())
  leftAt   DateTime?
  team     RoommateTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([userId, active])
}

model RoommateTeamInvite {
  id          String                   @id @default(cuid())
  matchId     String
  inviterId   String
  inviteeId   String
  teamId      String?
  status      RoommateTeamInviteStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  match       RoommateMatch            @relation(fields: [matchId], references: [id], onDelete: Restrict)
  inviter     User                     @relation("RoommateTeamInviteInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  invitee     User                     @relation("RoommateTeamInviteInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  team        RoommateTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([inviterId, status, createdAt])
  @@index([inviteeId, status, createdAt])
  @@index([matchId, status])
}

model RoommateConversation {
  id            String                       @id @default(cuid())
  matchId       String                       @unique
  lastMessageAt DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  match         RoommateMatch                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members       RoommateConversationMember[]
  messages      RoommateMessage[]
}

model RoommateConversationMember {
  id                String               @id @default(cuid())
  conversationId    String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  conversation      RoommateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
}

model RoommateMessage {
  id              String               @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String
  body            String
  createdAt       DateTime             @default(now())
  conversation    RoommateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model RoommateMatchingProfile {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  user                   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                 String?
  city                   String?
  budgetMin              Int?      @map("budget_min")
  budgetMax              Int?      @map("budget_max")
  moveInDate             DateTime? @map("move_in_date") @db.Date
  moveOutDate            DateTime? @map("move_out_date") @db.Date
  preferredNeighborhoods String[]  @default([]) @map("preferred_neighborhoods")
  roomType               String?   @map("room_type")
  cleanliness            String?
  sleepSchedule          String?   @map("sleep_schedule")
  smoking                String?
  pets                   String?
  guests                 String?
  intro                  String?
  lookingFor             String?   @map("looking_for")
  status                 String    @default("active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([city, school, status])
  @@index([budgetMin, budgetMax])
  @@map("roommate_profiles")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  budget    String
  members   Json
  createdAt DateTime @default(now())
}

model Booking {
  id        String   @id @default(cuid())
  listingId String
  title     String
  amount    Int
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustQueueItem {
  id        String   @id @default(cuid())
  label     String
  value     Int
  variant   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoommateAction {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roommateProfileId String
  roommateProfile   RoommateProfile    @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  action            RoommateActionType
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, roommateProfileId])
  @@index([userId])
  @@index([roommateProfileId])
}

model DealRoom {
  id                String           @id @default(cuid())
  ownerId           String
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roommateProfileId String
  roommateProfile   RoommateProfile  @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  status            DealRoomStatus   @default(ACTIVE)
  recommendedHomes  Json
  pipeline          Json
  trustChecklist    Json
  members           DealRoomMember[]
  tourRequest       TourRequest?
  threads           DealThread[]
  roommateTeam      RoommateTeam?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Active-pair uniqueness is enforced by a partial index in the migration.
  @@index([ownerId, status, updatedAt])
  @@index([roommateProfileId])
}

model DealRoomMember {
  id                String          @id @default(cuid())
  dealRoomId        String
  dealRoom          DealRoom        @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  roommateProfileId String
  roommateProfile   RoommateProfile @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  snapshot          Json
  createdAt         DateTime        @default(now())

  @@unique([dealRoomId, roommateProfileId])
  @@index([dealRoomId])
  @@index([roommateProfileId])
}

model TourRequest {
  id          String            @id @default(cuid())
  dealRoomId  String            @unique
  dealRoom    DealRoom          @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  status      TourRequestStatus @default(REQUESTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([requesterId, status, createdAt])
}

model DealThread {
  legacyLeaseApplication LeaseApplication? @ignore
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation("RenterDealThreads", fields: [ownerId], references: [id], onDelete: Cascade)
  listingOwnerId   String
  listingOwner     User             @relation("ListingOwnerDealThreads", fields: [listingOwnerId], references: [id], onDelete: Cascade)
  dealRoomId       String?
  dealRoom         DealRoom?        @relation(fields: [dealRoomId], references: [id], onDelete: SetNull)
  listingId        String
  listing          Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingTitle     String
  area             String
  contactName      String
  participantNames String[]         @default([])
  messages         DealMessage[]
  viewingRequests  ViewingRequest[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([ownerId, listingId])
  @@index([ownerId, updatedAt])
  @@index([listingOwnerId, updatedAt])
  @@index([dealRoomId])
}

model DealMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     DealThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  clientMessageId String?
  body       String
  align      String     @default("right")
  status     String     @default("sent")
  createdAt  DateTime   @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
  @@unique([senderId, clientMessageId])
}

model ViewingRequest {
  id               String               @id @default(cuid())
  threadId         String
  thread           DealThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  listingId        String
  listingTitle     String
  area             String
  timeLabel        String
  iso              DateTime
  mode             ViewingMode
  participantNames String[]             @default([])
  status           ViewingRequestStatus @default(REQUESTED)
  revision         Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([threadId, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([listingId, status, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationPurpose {
  LOGIN
  ADMIN_STEP_UP
}

enum VerificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum MediaStorageStatus {
  PENDING
  READY
  PUBLISHED
  FAILED
}

enum MediaReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoommateActionType {
  LIKE
  PASS
  LATER
}

enum DealRoomStatus {
  ACTIVE
  ARCHIVED
}

enum TourRequestStatus {
  REQUESTED
  SCHEDULED
  CANCELLED
}

enum ViewingMode {
  IN_PERSON
  VIDEO
}

enum ViewingRequestStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  role            UserRole         @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  listings        Listing[]
  roommateActions RoommateAction[]
  ownedDealRooms  DealRoom[]
  tourRequests    TourRequest[]
  renterDealThreads DealThread[]       @relation("RenterDealThreads")
  ownedListingThreads DealThread[]      @relation("ListingOwnerDealThreads")
  dealMessages    DealMessage[]
  viewingRequests ViewingRequest[]
  roommateProfile RoommateProfile? @relation("RoommateProfileOwner")
  firstRoommateMatches RoommateMatch[] @relation("RoommateMatchFirstUser")
  secondRoommateMatches RoommateMatch[] @relation("RoommateMatchSecondUser")
  roommateConversationMemberships RoommateConversationMember[]
  sentRoommateMessages RoommateMessage[]
}

model Profile {
  id               String                    @id @default(uuid()) @db.Uuid
  email            String                    @unique
  displayName      String?                   @map("display_name")
  avatarUrl        String?                   @map("avatar_url")
  school           String?
  city             String?
  role             String                    @default("renter")
  eduEmailVerified Boolean                   @default(false) @map("edu_email_verified")
  phoneVerified    Boolean                   @default(false) @map("phone_verified")
  wechat           String?
  instagram        String?
  bio              String?
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  roommateProfiles RoommateMatchingProfile[]
  housingListings  HousingListing[]

  @@index([school, city])
  @@map("profiles")
}

model VerificationCode {
  id                String                     @id @default(cuid())
  email             String
  purpose           VerificationPurpose        @default(LOGIN)
  codeHash          String
  codeSalt          String?
  hashVersion       Int                        @default(1)
  attemptCount      Int                        @default(0)
  deliveryStatus    VerificationDeliveryStatus @default(PENDING)
  sentAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                   @default(now())

  @@index([email, consumedAt, expiresAt])
  @@index([email, purpose, deliveryStatus, createdAt])
  @@index([deliveryStatus, createdAt])
}

model BetaInvite {
  id               String    @id @default(cuid())
  normalizedEmail  String    @unique
  createdBy        String
  reason           String?
  invitedAt        DateTime  @default(now())
  claimedAt        DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  @@index([normalizedEmail, revokedAt])
  @@index([invitedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorType   String
  actorUserId String?
  actorEmail  String?
  action      String
  targetType  String
  targetId    String?
  outcome     String
  requestId   String?
  ipHash      String?
  deviceHash  String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([requestId])
}

model Listing {
  id              String         @id @default(cuid())
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id])
  title           String
  area            String
  image           String?
  price           Int
  originalPrice   Int
  beds            Int
  baths           Int
  commute         String
  transit         String
  trust           String
  tags            String[]
  score           Float          @default(4.8)
  status          ListingStatus  @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  rejectionReason String?
  suspendedAt     DateTime?
  suspendedBy     String?
  suspensionReason String?
  media           ListingMedia[]
  dealThreads     DealThread[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([ownerId, status, updatedAt])
}

model HousingListing {
  id                String    @id @default(uuid()) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  owner             Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  listingType       String    @map("listing_type")
  propertyType      String    @map("property_type")
  roomType          String    @map("room_type")
  priceMonthly      Int       @map("price_monthly")
  depositAmount     Int?      @map("deposit_amount")
  city              String
  neighborhood      String?
  schoolNearby      String?   @map("school_nearby")
  addressApprox     String?   @map("address_approx")
  lat               Decimal?  @db.Decimal(9, 6)
  lng               Decimal?  @db.Decimal(9, 6)
  moveInDate        DateTime  @map("move_in_date") @db.Date
  moveOutDate       DateTime? @map("move_out_date") @db.Date
  flexibleDates     Boolean   @default(false) @map("flexible_dates")
  bedrooms          Decimal   @db.Decimal(4, 1)
  bathrooms         Decimal   @db.Decimal(4, 1)
  furnished         Boolean   @default(false)
  utilitiesIncluded Boolean   @default(false) @map("utilities_included")
  laundry           Boolean   @default(false)
  parking           Boolean   @default(false)
  petsAllowed       Boolean   @default(false) @map("pets_allowed")
  leaseApproved     Boolean   @default(false) @map("lease_approved")
  description       String?
  photoUrls         String[]  @default([]) @map("photo_urls")
  status            String    @default("draft")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId, status, updatedAt])
  @@index([city, neighborhood, priceMonthly])
  @@index([listingType, roomType, status])
  @@map("listings")
}

model ListingMedia {
  id                 String             @id @default(cuid())
  listingId          String
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url                String?
  kind               String
  sortOrder          Int                @default(0)
  originalKey        String?
  processedKey       String?
  publicMainKey      String?
  publicThumbnailKey String?
  mimeType           String?
  sizeBytes          Int?
  width              Int?
  height             Int?
  checksum           String?
  uploadExpiresAt    DateTime?
  storageStatus      MediaStorageStatus @default(PENDING)
  reviewStatus       MediaReviewStatus  @default(PENDING)
  finalizedAt        DateTime?
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([listingId, storageStatus, sortOrder])
  @@index([listingId, reviewStatus, sortOrder])
  @@index([uploadExpiresAt])
}

model RoommateProfile {
  id              String           @id @default(cuid())
  ownerId         String?          @unique
  owner           User?            @relation("RoommateProfileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name            String
  age             Int
  role            String
  image           String
  match           Int
  budget          String
  commute         String
  tags            String[]
  status          String           @default("active")
  archivedAt      DateTime?
  localReciprocalLike Boolean      @default(false)
  createdAt       DateTime         @default(now())
  actions         RoommateAction[]
  dealRooms       DealRoom[]
  dealRoomMembers DealRoomMember[]

  @@index([status, match])
}

enum RoommateMatchStatus {
  ACTIVE
  CLOSED
}

model RoommateMatch {
  id           String              @id @default(cuid())
  firstUserId  String
  secondUserId String
  status       RoommateMatchStatus @default(ACTIVE)
  matchedAt    DateTime            @default(now())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  firstUser    User                @relation("RoommateMatchFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser   User                @relation("RoommateMatchSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  conversation RoommateConversation?

  @@unique([firstUserId, secondUserId])
  @@index([firstUserId, status, updatedAt])
  @@index([secondUserId, status, updatedAt])
}

model RoommateConversation {
  id            String   @id @default(cuid())
  matchId       String   @unique
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  match         RoommateMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members       RoommateConversationMember[]
  messages      RoommateMessage[]
}

model RoommateConversationMember {
  id             String               @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversation   RoommateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
}

model RoommateMessage {
  id              String               @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String
  body            String
  createdAt       DateTime             @default(now())
  conversation    RoommateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model RoommateMatchingProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  user                   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                 String?
  city                   String?
  budgetMin              Int?      @map("budget_min")
  budgetMax              Int?      @map("budget_max")
  moveInDate             DateTime? @map("move_in_date") @db.Date
  moveOutDate            DateTime? @map("move_out_date") @db.Date
  preferredNeighborhoods String[]  @default([]) @map("preferred_neighborhoods")
  roomType               String?   @map("room_type")
  cleanliness            String?
  sleepSchedule          String?   @map("sleep_schedule")
  smoking                String?
  pets                   String?
  guests                 String?
  intro                  String?
  lookingFor             String?   @map("looking_for")
  status                 String    @default("active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([city, school, status])
  @@index([budgetMin, budgetMax])
  @@map("roommate_profiles")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  budget    String
  members   Json
  createdAt DateTime @default(now())
}

model Booking {
  id        String   @id @default(cuid())
  listingId String
  title     String
  amount    Int
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustQueueItem {
  id        String   @id @default(cuid())
  label     String
  value     Int
  variant   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoommateAction {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roommateProfileId String
  roommateProfile   RoommateProfile    @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  action            RoommateActionType
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, roommateProfileId])
  @@index([userId])
  @@index([roommateProfileId])
}

model DealRoom {
  id                String           @id @default(cuid())
  ownerId           String
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roommateProfileId String
  roommateProfile   RoommateProfile  @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  status            DealRoomStatus   @default(ACTIVE)
  recommendedHomes  Json
  pipeline          Json
  trustChecklist    Json
  members           DealRoomMember[]
  tourRequest       TourRequest?
  threads           DealThread[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([ownerId, roommateProfileId])
  @@index([ownerId, status, updatedAt])
  @@index([roommateProfileId])
}

model DealRoomMember {
  id                String          @id @default(cuid())
  dealRoomId        String
  dealRoom          DealRoom        @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  roommateProfileId String
  roommateProfile   RoommateProfile @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  snapshot          Json
  createdAt         DateTime        @default(now())

  @@unique([dealRoomId, roommateProfileId])
  @@index([dealRoomId])
  @@index([roommateProfileId])
}

model TourRequest {
  id          String            @id @default(cuid())
  dealRoomId  String            @unique
  dealRoom    DealRoom          @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  status      TourRequestStatus @default(REQUESTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([requesterId, status, createdAt])
}

model DealThread {
  id              String           @id @default(cuid())
  ownerId         String
  owner           User             @relation("RenterDealThreads", fields: [ownerId], references: [id], onDelete: Cascade)
  listingOwnerId  String
  listingOwner    User             @relation("ListingOwnerDealThreads", fields: [listingOwnerId], references: [id], onDelete: Cascade)
  dealRoomId      String?
  dealRoom        DealRoom?        @relation(fields: [dealRoomId], references: [id], onDelete: SetNull)
  listingId       String
  listing         Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingTitle    String
  area            String
  contactName     String
  participantNames String[]        @default([])
  messages        DealMessage[]
  viewingRequests ViewingRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([ownerId, listingId])
  @@index([ownerId, updatedAt])
  @@index([listingOwnerId, updatedAt])
  @@index([dealRoomId])
}

model DealMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     DealThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String
  body       String
  align      String     @default("right")
  status     String     @default("sent")
  createdAt  DateTime   @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
}

model ViewingRequest {
  id               String               @id @default(cuid())
  threadId         String
  thread           DealThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  listingId        String
  listingTitle     String
  area             String
  timeLabel        String
  iso              DateTime
  mode             ViewingMode
  participantNames String[]             @default([])
  status           ViewingRequestStatus @default(REQUESTED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([threadId, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([listingId, status, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum RoommateActionType {
  LIKE
  PASS
  LATER
}

enum DealRoomStatus {
  ACTIVE
  ARCHIVED
}

enum TourRequestStatus {
  REQUESTED
  SCHEDULED
  CANCELLED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  role             UserRole          @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  listings         Listing[]
  roommateActions  RoommateAction[]
  ownedDealRooms   DealRoom[]
  tourRequests     TourRequest[]
}

model VerificationCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attemptCount Int     @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, consumedAt, expiresAt])
}

model Listing {
  id            String         @id @default(cuid())
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id])
  title         String
  area          String
  image         String
  price         Int
  originalPrice Int
  beds          Int
  baths         Int
  commute       String
  transit       String
  trust         String
  tags          String[]
  score         Float          @default(4.8)
  status        ListingStatus  @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewerId    String?
  rejectionReason String?
  media         ListingMedia[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([ownerId, status, updatedAt])
}

model ListingMedia {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  kind      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model RoommateProfile {
  id              String            @id @default(cuid())
  name            String
  age             Int
  role            String
  image           String
  match           Int
  budget          String
  commute         String
  tags            String[]
  createdAt       DateTime          @default(now())
  actions         RoommateAction[]
  dealRooms       DealRoom[]
  dealRoomMembers DealRoomMember[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  budget    String
  members   Json
  createdAt DateTime @default(now())
}

model Booking {
  id        String   @id @default(cuid())
  listingId String
  title     String
  amount    Int
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustQueueItem {
  id        String   @id @default(cuid())
  label     String
  value     Int
  variant   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoommateAction {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roommateProfileId  String
  roommateProfile    RoommateProfile     @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  action             RoommateActionType
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, roommateProfileId])
  @@index([userId])
  @@index([roommateProfileId])
}

model DealRoom {
  id                 String              @id @default(cuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roommateProfileId  String
  roommateProfile    RoommateProfile     @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  status             DealRoomStatus      @default(ACTIVE)
  recommendedHomes   Json
  pipeline           Json
  trustChecklist     Json
  members            DealRoomMember[]
  tourRequest        TourRequest?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([ownerId, roommateProfileId])
  @@index([ownerId, status, updatedAt])
  @@index([roommateProfileId])
}

model DealRoomMember {
  id                 String          @id @default(cuid())
  dealRoomId         String
  dealRoom           DealRoom        @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  roommateProfileId  String
  roommateProfile    RoommateProfile @relation(fields: [roommateProfileId], references: [id], onDelete: Cascade)
  snapshot           Json
  createdAt          DateTime        @default(now())

  @@unique([dealRoomId, roommateProfileId])
  @@index([dealRoomId])
  @@index([roommateProfileId])
}

model TourRequest {
  id          String            @id @default(cuid())
  dealRoomId  String            @unique
  dealRoom    DealRoom          @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  status      TourRequestStatus @default(REQUESTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([requesterId, status, createdAt])
}

{
  "name": "sublet-pipeline-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "test:cli-build": "node ../tools/api-command.mjs test:cli-build",
    "start": "node dist/src/main.js",
    "pretest": "prisma generate",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "launch:check": "node ../tools/api-command.mjs launch:check",
    "launch:smoke": "node ../tools/api-command.mjs launch:smoke",
    "launch:smoke:marketplace": "node ../tools/api-command.mjs launch:smoke:marketplace",
    "launch:smoke:roommate": "node ../tools/api-command.mjs launch:smoke:roommate",
    "launch:smoke:valkey": "node ../tools/api-command.mjs launch:smoke:valkey",
    "seed:marketplace": "node ../tools/api-command.mjs seed:marketplace",
    "seed:la": "pnpm seed:marketplace",
    "beta:invites": "node dist/src/operations/beta-invites.cli.js",
    "beta:invites:dev": "ts-node -r tsconfig-paths/register src/operations/beta-invites.cli.ts",
    "admin:roles": "node dist/src/operations/admin-roles.cli.js",
    "admin:roles:dev": "ts-node -r tsconfig-paths/register src/operations/admin-roles.cli.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "file-type": "21.3.2",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/node": "^22.20.4",
    "prisma": "^6.19.3",
    "socket.io-client": "4.8.3",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

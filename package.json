{
  "name": "sublet-pipeline-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "dev:local": "pnpm --include-workspace-root --parallel --stream --filter sublet-pipeline-web --filter sublet-pipeline-api dev",
    "local:setup": "sh tools/local-setup.sh",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "node tools/release-check.mjs",
    "production:check-config": "node -- tools/production-config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@next/swc-wasm-nodejs": "15.5.27",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<1.20.6": "1.20.6",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "engine.io": "6.6.11",
      "file-type@<21.3.2": "22.1.1",
      "lodash@<4.18.0": "4.18.1",
      "multer@<2.4.0": "2.4.0",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.29": "8.5.29",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}

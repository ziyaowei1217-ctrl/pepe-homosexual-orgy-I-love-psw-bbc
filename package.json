      "ajv@^8": "8.20.0",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "proxy-addr": "2.0.8",
      "engine.io": "6.6.11",
      "vite": "8.3.5",
      "jsdom": "26.1.0",
      "picomatch@4": "4.0.7",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",

{
  "name": "sublet-pipeline-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "dev:local": "pnpm --include-workspace-root --parallel --stream --filter sublet-pipeline-web --filter sublet-pipeline-api dev",
    "local:setup": "sh tools/local-setup.sh",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "node tools/release-check.mjs",
    "production:check-config": "node -- tools/production-config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",

{
  "name": "sublet-pipeline-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "dev:local": "pnpm --include-workspace-root --parallel --stream --filter sublet-pipeline-web --filter sublet-pipeline-api dev",
    "local:setup": "node tools/local-setup.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "node tools/release-check.mjs",
    "production:check-config": "node -- tools/production-config.mjs",
    "test:browser": "node tools/browser-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "^2.6.1",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@next/swc-wasm-nodejs": "15.5.27",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "lodash": "4.18.0",
      "qs": "6.16.0",
      "body-parser": "1.20.6",
      "multer": "2.4.0",
      "file-type@20.4.1": "21.3.2",
      "glob@10.4.5": "10.5.0",
      "tmp": "0.2.7",
      "webpack": "5.104.1",
      "picomatch@4.0.1": "4.0.4",
      "deepmerge-ts": "8.0.0",
      "ajv@^8": "8.18.0"
    }
  }
}

FROM node:22-alpine AS build
# Prisma 6 detects its native musl/OpenSSL engine during generation. Install the
# same TLS/system libraries in both stages, rather than falling back to libssl1.1.
RUN apk add --no-cache openssl ca-certificates zlib
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api/package.json api/package.json
RUN pnpm install --frozen-lockfile
COPY api ./api
RUN pnpm -C api build

FROM node:22-alpine AS runtime
RUN apk add --no-cache openssl ca-certificates zlib
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/api/node_modules ./api/node_modules
COPY --from=build /app/api/dist ./api/dist
COPY --from=build /app/api/package.json ./api/package.json
COPY --from=build /app/api/prisma ./api/prisma
USER node
EXPOSE 4000
CMD ["node", "api/dist/src/main.js"]

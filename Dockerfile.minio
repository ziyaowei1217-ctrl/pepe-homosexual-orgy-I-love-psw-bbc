# The former official MinIO container tags are no longer publicly pullable.
# Build the same releases from verified official source, without a mirror image.
FROM golang:1.24.13-alpine3.22@sha256:3641e0d9b931dc4f2f185dcd669c4679670e9277c8166a838ddb98a2d4389cb5 AS builder
RUN apk add --no-cache ca-certificates curl
ENV CGO_ENABLED=0 GOTOOLCHAIN=local

FROM builder AS server-build
WORKDIR /src/minio
RUN curl --fail --location --retry 3 \
      https://codeload.github.com/minio/minio/tar.gz/07c3a429bfed433e49018cb0f78a52145d4bedeb \
      --output /tmp/source.tar.gz \
    && echo "8819e3e7817e46b7b3798f8f200ead208562e571563c2e040352378031abe9f2  /tmp/source.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 \
    && rm /tmp/source.tar.gz
RUN go mod download && go mod verify \
    && go build -p 2 -mod=readonly -buildvcs=false -trimpath -tags kqueue \
      -ldflags "-s -w -X github.com/minio/minio/cmd.Version=2025-09-07T16:13:09Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-09-07T16-13-09Z -X github.com/minio/minio/cmd.CommitID=07c3a429bfed433e49018cb0f78a52145d4bedeb -X github.com/minio/minio/cmd.ShortCommitID=07c3a429bfed4 -X github.com/minio/minio/cmd.CopyrightYear=2025" \
      -o /out/minio .

FROM builder AS client-build
WORKDIR /src/mc
RUN curl --fail --location --retry 3 \
      https://codeload.github.com/minio/mc/tar.gz/7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
      --output /tmp/source.tar.gz \
    && echo "95cd293c7119f16921a6dc515a1fb74a2227f19fd994b9c8b770a154e802ac44  /tmp/source.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 \
    && rm /tmp/source.tar.gz
RUN go mod download && go mod verify \
    && go build -p 2 -mod=readonly -buildvcs=false -trimpath -tags kqueue \
      -ldflags "-s -w -X github.com/minio/mc/cmd.Version=2025-08-13T08:35:41Z -X github.com/minio/mc/cmd.ReleaseTag=RELEASE.2025-08-13T08-35-41Z -X github.com/minio/mc/cmd.CommitID=7394ce0dd2a80935aded936b09fa12cbb3cb8096 -X github.com/minio/mc/cmd.ShortCommitID=7394ce0dd2a8 -X github.com/minio/mc/cmd.CopyrightYear=2025" \
      -o /out/mc .

FROM alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11 AS runtime-base
RUN apk add --no-cache ca-certificates curl

FROM runtime-base AS client
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
      org.opencontainers.image.revision="7394ce0dd2a80935aded936b09fa12cbb3cb8096" \
      org.opencontainers.image.version="RELEASE.2025-08-13T08-35-41Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=client-build /out/mc /usr/bin/mc
COPY --from=client-build /src/mc/LICENSE /src/mc/NOTICE /src/mc/CREDITS /licenses/mc/
ENTRYPOINT ["mc"]

FROM runtime-base AS server
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb" \
      org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=server-build /out/minio /usr/bin/minio
COPY --from=server-build /src/minio/LICENSE /src/minio/NOTICE /src/minio/CREDITS /licenses/minio/
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
